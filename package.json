{
  "name": "technopark-guidelines",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc && tsc -p tools/cookie-viewer",
    "validate": "bun scripts/eraser.ts validate",
    "check": "bun scripts/check-colors.ts",
    "warm": "bun scripts/warm-icons.ts",
    "render": "bun scripts/docker.ts render",
    "render:native": "bun scripts/eraser.ts render -f png",
    "fresh": "bun scripts/freshness.ts",
    "links": "bun scripts/check-links.ts",
    "mermaid": "bun scripts/docker.ts mermaid",
    "mermaid:native": "bun scripts/check-mermaid.ts",
    "icons": "bun scripts/fetch-icons.ts",
    "site:dev": "vitepress dev",
    "site:build": "vitepress build",
    "site:preview": "vitepress preview",
    "site:check": "bun scripts/check-site.ts",
    "ext:build": "bun scripts/build-extension.ts build",
    "ext:zip": "bun scripts/build-extension.ts zip"
  },
  "devDependencies": {
    "@eraserlabs/diagrams-cli": "0.1.0",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@types/bun": "1.4.2",
    "@types/chrome": "0.3.4",
    "fflate": "0.8.3",
    "medium-zoom": "1.1.0",
    "mermaid": "^11",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
